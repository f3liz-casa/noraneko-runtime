# SPDX-License-Identifier: MPL-2.0

ac_add_options --with-app-name=noraneko
ac_add_options --with-app-basename=Noraneko
ac_add_options --disable-crashreporter
ac_add_options --enable-bootstrap
ac_add_options --enable-rust-simd
ac_add_options --target=aarch64-apple-darwin

# LLVM and Linker
export CC=clang-20
export CXX=clang++-20
ac_add_options --enable-linker=lld
ac_add_options --enable-lto=thin

# Optimization
ac_add_options --enable-release
ac_add_options --enable-optimize

mk_add_options AUTOCLOBBER=1
ac_add_options MOZ_TELEMETRY_REPORTING=
ac_add_options --with-branding=browser/branding/noraneko-unofficial
# bundle id は {distribution-id}.{MOZ_MACBUNDLE_ID}(toolkit/moz.configure)。casa.f3liz.noraneko にする
ac_add_options --with-distribution-id=casa.f3liz
export MOZ_PACKAGE_JSSHELL=1

# sccache: 箱では SCCACHE_DIR(local disk)か SCCACHE_BUCKET(S3互換=B2)が入る。GHA では未設定=無効。
if [ -n "${SCCACHE_DIR:-}${SCCACHE_BUCKET:-}" ]; then
  ac_add_options --with-ccache=/usr/local/bin/sccache
  mk_add_options "export RUSTC_WRAPPER=/usr/local/bin/sccache"
  [ -n "${SCCACHE_DIR:-}" ] && mk_add_options "export SCCACHE_DIR=$SCCACHE_DIR"
  [ -n "${SCCACHE_DIR:-}" ] && mk_add_options "export SCCACHE_CACHE_SIZE=${SCCACHE_CACHE_SIZE:-50G}"
  for v in SCCACHE_BUCKET SCCACHE_ENDPOINT SCCACHE_REGION SCCACHE_S3_KEY_PREFIX AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY; do
    eval "val=\${$v:-}"; [ -n "$val" ] && mk_add_options "export $v=$val"
  done
fi
